pkgname=vinylplayer
pkgver=0.2.1
pkgrel=1
pkgdesc='Analog-inspired, lightweight, and native music player for the Linux desktop'
arch=('x86_64')
url='https://github.com/dznass-cmd/VinylPlayer'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugin-pipewire')
optdepends=(
  'ffmpeg: leitura de metadados e tags avançadas com ffprobe'
  'flac: extração de capas embutidas em FLAC com metaflac'
)
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/VinylPlayer-$pkgver.tar.gz")
sha256sums=('7eaa5b7f55c7711ff84ae6f1cab5a0d39929782f42bd71bb7e59b1ce94ef1a3a')

prepare() {
  cd "VinylPlayer-$pkgver"
  cargo fetch --locked
}

build() {
  cd "VinylPlayer-$pkgver"
  cargo build --release --locked
}

package() {
  cd "VinylPlayer-$pkgver"
  install -Dm755 target/release/vinylplayer "$pkgdir/usr/bin/vinylplayer"
  install -Dm644 vinylplayer.desktop "$pkgdir/usr/share/applications/io.github.vinylplayer.desktop"
  install -Dm644 assets/vinylplayer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.vinylplayer.svg"
  install -Dm644 assets/vinylplayer.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vinylplayer.svg"
}
