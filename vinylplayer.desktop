[Desktop Entry]
Version=1.0
Type=Application
Name=VinylPlayer
GenericName=Music Player
Comment=Analog-inspired, lightweight, and native music player
Exec=vinylplayer %U
Icon=io.github.vinylplayer
Terminal=false
Categories=Audio;AudioVideo;Player;GTK;
MimeType=audio/flac;audio/mpeg;audio/ogg;audio/wav;audio/x-wav;audio/mp4;audio/aac;audio/opus;
StartupNotify=true
StartupWMClass=io.github.vinylplayer
Keywords=music;player;audio;vinyl;turntable;
